generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Roles: analyst | approver | admin | auditor | support_agent (see src/platform/permissions.ts)
model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  role         String
  passwordHash String

  assignedCases         KycCase[]              @relation("AssignedCases")
  assignedDisputes      Dispute[]              @relation("AssignedDisputes")
  approvalRequests      ApprovalRequest[]      @relation("RequestedApprovals")
  approvalDecided       ApprovalRequest[]      @relation("DecidedApprovals")
  approvalConfirmations ApprovalConfirmation[]
  requestedRefunds      Refund[]               @relation("RequestedRefunds")
}

// Status: NEW | IN_REVIEW | PENDING_APPROVAL | APPROVED | REJECTED
model KycCase {
  id            String   @id @default(cuid())
  applicantName String
  dateOfBirth   String
  nationalId    String
  address       String
  riskScore     Int
  riskFlags     String // JSON array of strings
  status        String   @default("NEW")
  assignedToId  String?
  assignedTo    User?    @relation("AssignedCases", fields: [assignedToId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
}

// Status: NEW | IN_REVIEW | PENDING_APPROVAL | ACCEPTED | CHALLENGED
// Proposal: accept | fight (set by the analyst's proposal; the final status is set by the approvals engine)
model Dispute {
  id                String   @id @default(cuid())
  caseReference     String   @unique
  paymentReference  String
  amountCents       Int
  currency          String
  paymentDate       DateTime
  reasonCode        String
  customerStatement String
  cardholderName    String // PII
  cardLast4         String
  customerEmail     String // PII
  respondBy         DateTime
  status            String   @default("NEW")
  proposal          String?
  evidenceSummary   String?
  assignedToId      String?
  assignedTo        User?    @relation("AssignedDisputes", fields: [assignedToId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
  @@index([respondBy])
}

// Status: PENDING | CONFIRMED | RETURNED. Stays PENDING until the action's requiredApprovals
// confirmations have been recorded; the confirmation that completes them sets decidedById.
model ApprovalRequest {
  id            String                 @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  payload       String // JSON
  requestedById String
  requestedBy   User                   @relation("RequestedApprovals", fields: [requestedById], references: [id])
  requestedAt   DateTime               @default(now())
  requestNote   String
  status        String                 @default("PENDING")
  decidedById   String?
  decidedBy     User?                  @relation("DecidedApprovals", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  confirmations ApprovalConfirmation[]

  @@index([status])
  @@index([entityType, entityId])
}

// One row per approver who confirmed a request (including the final one); an approver confirms once.
model ApprovalConfirmation {
  id          String          @id @default(cuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id])
  approverId  String
  approver    User            @relation(fields: [approverId], references: [id])
  confirmedAt DateTime        @default(now())
  note        String

  @@unique([requestId, approverId])
}

// Append-only: triggers in prisma/migrations reject UPDATE and DELETE.
model AuditEvent {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  actorId    String
  actorRole  String
  action     String
  entityType String
  entityId   String
  before     String? // JSON
  after      String? // JSON
  reason     String?

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

// Status: PENDING_APPROVAL | ISSUED | RETURNED (final statuses set only by the refunds.issue approval action)
model Refund {
  id            String    @id @default(cuid())
  paymentId     String
  customerName  String
  customerEmail String // PII
  cardLast4     String
  amountCents   Int
  currency      String
  reason        String
  status        String    @default("PENDING_APPROVAL")
  requestedById String
  requestedBy   User      @relation("RequestedRefunds", fields: [requestedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  issuedAt      DateTime?

  @@index([status])
  @@index([paymentId])
  @@index([requestedById])
}

// Ledger of the mock payments connector (src/connectors/payments.ts): one row per issueRefund call.
model MockPaymentCall {
  id               String   @id @default(cuid())
  paymentId        String
  amountCents      Int
  idempotencyKey   String   @unique
  providerRefundId String
  createdAt        DateTime @default(now())
}
