# Copy to .env and fill in. Never commit .env.

# SQLite database file (relative to the project root)
DATABASE_URL="file:./dev.db"

# Session cookie encryption key. Must be at least 32 characters; the app refuses to start otherwise.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Password given to every seeded user (development only)
SEED_PASSWORD="password123"
